<string name="rollback_warning_title">Abnormal rollback index detected</string>
<string name="rollback_warning_intro">The rollback index is the only AVB value written to RPMB. Once the device accepts a signed image, the stored minimum rises permanently and older images will no longer boot.</string>
<string name="rollback_warning_unrecognized">Value %1$s matches no known rollback index scheme (neither a release counter nor an SPL UNIX timestamp). It may be mistyped or come from an untrusted tutorial or config.</string>
<string name="rollback_warning_future">Value %1$s decodes to date %2$s, more than one year ahead of this device\'s date (%3$s). Usual causes: milliseconds instead of seconds, one extra digit, or an untrusted source.</string>
<string name="rollback_warning_future_unrepresentable">Value %1$s is beyond any representable date. Usual causes: milliseconds instead of seconds, one extra digit, or an untrusted source.</string>
<string name="rollback_warning_invalid">Value %1$s is not a writable 64-bit unsigned integer (0 to 18446744073709551615). avbtool cannot write this value.</string>
